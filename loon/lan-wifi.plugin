#!name = CF 服务局域网直连
#!desc = 指定 Wi-Fi 下把 CF 隧道的服务域名改写为局域网 IP 直连，其他网络保持公网。需要开启 MITM 并信任 Loon 证书。局域网 HTTP 会明文传输凭据，仅用于可信网络。
#!author = sgr997
#!loon_version = 3.5.1(983)
#!type = normal

[Argument]
homeWifi = input,"",tag=触发 Wi-Fi 名称,desc=连上这个 Wi-Fi 时才改写；多个 SSID 用英文或中文逗号分隔；留空则始终走公网
lanIp = input,"",tag=局域网 IP,desc=形如 192.168.31.115，不填协议和端口；留空则始终走公网
services = input,"",tag=额外服务端口,desc=可选，格式 host=port，多个用逗号分隔；覆盖或补充插件内置的端口表

[Script]
request if ${url} ~= /^https:\/\/(mag|nav|cpa|dash|skills|hindsight|vault|wb2|xhx2api|agent2api)\.goku\.top(?=\/|$)/i then script("https://raw.githubusercontent.com/sgr997/proxy-rule/main/loon/lan-wifi.js", {${homeWifi}, ${lanIp}, ${services}}) with tag="局域网直连", timeout=40, requires_body=true, binary_body_mode=true

[Mitm]
hostname = mag.goku.top, nav.goku.top, cpa.goku.top, dash.goku.top, hindsight.goku.top, vault.goku.top, wb2.goku.top, xhx2api.goku.top
